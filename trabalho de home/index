<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Festejando a Conexão Campo-Cidade</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f0f8ff;
            text-align: center;
            padding: 50px;
        }
        h1 {
            color: #2e8b57;
        }
        p {
            font-size: 1.2em;
        }
        button {
            padding: 10px 20px;
            font-size: 1em;
            margin-top: 20px;
            cursor: pointer;
            background-color: #ffa500;
            border: none;
            border-radius: 5px;
            color: white;
        }
        #message {
            margin-top: 30px;
            font-size: 1.3em;
            color: #333;
        }
    </style>
</head>
<body>
    <h1>Celebrando a Conexão entre Campo e Cidade</h1>
    <p>Vamos celebrar a união e a beleza de ambos os mundos!</p>
    <button onclick="celebrarConexao()">Celebrar!</button>
    <div id="message"></div>

    <script>
        function celebrarConexao() {
            const mensagens = [
                "O campo e a cidade, juntos, criam uma harmonia única!",
                "A conexão entre o rural e o urbano fortalece nossa cultura.",
                "Celebramos a diversidade e a união de todos os lugares!",
                "Campo e cidade, de mãos dadas, construindo um futuro melhor!",
                "Cada canto tem sua beleza especial. Vamos valorizar ambos!"
            ];
            const mensagemAleatoria = mensagens[Math.floor(Math.random() * mensagens.length)];
            document.getElementById('message').textContent = mensagemAleatoria;
        }
    </script>
</body>
</html>